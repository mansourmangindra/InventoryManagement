@inject IHttpContextAccessor httpContextAccessor
@{
    string title = ViewData["title"] as string ?? "";
}

<!DOCTYPE html>
<html lang="en"
    class="light-style layout-compact"
    dir="ltr" data-theme="theme-semi-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@title | WfmHub</title>
    <meta name="description" content="" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />

    <!-- Core Styles -->
    @await Html.PartialAsync("~/Views/_Core/Layout/_MainAsset/_CoreHead.cshtml")

    <!-- Page Styles -->
    @await RenderSectionAsync("PageStyles", required: false)
</head>

<body>
    <!-- Layout Content -->
    <div class='layout-wrapper layout-navbar-full layout-horizontal layout-without-menu'>
        <div class='layout-container'>
            @await Html.PartialAsync("~/Views/_Core/Navbar/_NavbarHorizontal.cshtml")

            <!-- Layout page -->
            <div class="layout-page">

                <!-- Content wrapper -->
                <div class="content-wrapper">


                    @await Html.PartialAsync("~/Views/_Core/Menu/_HorizontalMenu.cshtml")

                    <!-- Content -->
                    <div class="flex-grow-1 container-p-y container-fluid">
                        @Html.AntiForgeryToken()
                        @RenderBody()
                        @{
                            await Html.RenderPartialAsync("~/Views/_Core/Modal/_OffCanvas.cshtml");
                        }
                    </div>
                    <!-- / Content -->
                    <!-- Footer -->
                    @await Html.PartialAsync("~/Views/_Core/Layout/Footer/_Footer.cshtml")
                    <!-- / Footer -->

                    <div class="content-backdrop fade"></div>
                </div>
                <!--/ Content wrapper -->

            </div>
            <!-- / Layout page -->

        </div>
    </div>
    <!--/ Layout Content -->

    <div class="layout-overlay layout-menu-toggle"></div>

    <div class="drag-target"></div>

    <!-- Core Scripts -->
    @await Html.PartialAsync("~/Views/_Core/Layout/_MainAsset/_CoreScript.cshtml")

    <!-- Page Scripts-->
    @await RenderSectionAsync("PageScripts", required: false)

</body>

</html>
@using Common.Constants;
@using WebApp.Extensions;
@inject WebApp.Services.Interfaces.ISecurityService _securityService;


@{

    string currentPage = ViewContext.HttpContext.Request.Path;



    List<string> applicatioRoleNames = User.ApplicationRoleName();
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
    <div class="app-brand demo align-items-center mt-2 mb-1">
        <a href="/" class="app-brand-link">
            <span class="app-brand-logo demo me-1">
                <img width="30" height="30" src="~/img/branding/AppLogoWhiteNoBg.png" alt="logo">
            </span>
            <h5 class="app-brand-text demo menu-text fw-semibold ms-2 mt-3">Inventory</h5>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="mdi menu-toggle-icon d-xl-block align-middle mdi-20px"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        <!-- User Management -->
        <li class='menu-item @(currentPage.StartsWith("/User") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <em class="menu-icon fa-solid fa-user-shield"></em>
                <div>User Management</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/User" ? " active" : "")'>
                    <a asp-controller="UserManagement" asp-action="Index" class="menu-link">
                        <div>Create</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/User/Search" ? " active" : "")'>
                    <a asp-controller="UserManagement" asp-action="Search" class="menu-link">
                        <div>Search</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- User Management -->
        <!-- Role -->
        <li class='menu-item @(currentPage.StartsWith("/Role") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <em class="menu-icon fa-solid fa-user-shield"></em>
                <div>Role Management</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Role" ? " active" : "")'>
                    <a asp-controller="Role" asp-action="Index" class="menu-link">
                        <div>Search</div>
                    </a>
                </li>
            </ul>
        </li>

        <li class='menu-item @(currentPage.StartsWith("/UserAccount") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <em class="menu-icon fa-solid fa-user-shield"></em>
                <div>ADMIN</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/UserAccount" ? " active" : "")'>
                    <a asp-controller="Maintenance" asp-action="Index" class="menu-link">
                        <div>ADMIN</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Module -->
        @if (await _securityService.WithRole(new short[] { IMConstant.ADMIN }, User))

        {
            

            <!-- Error Log -->
            <li class='menu-item @(currentPage.StartsWith("/Error") || currentPage.StartsWith("/Error") ? " active open" : "")'>
                <a href="javascript:void(0);" class="menu-link menu-toggle">
                    <i class="menu-icon tf-icons mdi mdi-database-edit-outline"></i>
                    <div>Module</div>
                </a>
                <ul class="menu-sub">
                    <li class='menu-item@(currentPage.StartsWith("/Error") ? " active" : "")'>
                        <a asp-controller="Error" asp-action="Index" class="menu-link">
                            <div>Error</div>
                        </a>
                    </li>
                    <li class='menu-item@(currentPage.StartsWith("/User") ? " active" : "")'>
                        <a asp-controller="User" asp-action="Index" class="menu-link">
                            <div>User</div>
                        </a>
                    </li>
                </ul>
            </li>
            <!-- Error Log -->
        }
        <!-- Module -->


    </ul>
</aside>
<!-- / Menu -->

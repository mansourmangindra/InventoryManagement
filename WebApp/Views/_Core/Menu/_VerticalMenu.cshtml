@{
  string currentPage = ViewContext.HttpContext.Request.Path;
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
  <div class="app-brand demo align-items-center mt-2 mb-1">
    <a href="/" class="app-brand-link">
      <span class="app-brand-logo demo me-1">
        <img width="30" height="30" src="~/img/branding/AppLogoWhiteNoBg.png" alt="logo">
      </span>
      <h5 class="app-brand-text demo menu-text fw-semibold ms-2 mt-3">DotNet8</h5>
    </a>
    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
      <i class="mdi menu-toggle-icon d-xl-block align-middle mdi-20px"></i>
    </a>
  </div>

  <div class="menu-inner-shadow"></div>

  <ul class="menu-inner py-1">
    <!-- Layout -->
    <li class='menu-item @(currentPage.StartsWith("/SampleOnly/Layout") ? " active open" : "")'>
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon tf-icons mdi mdi mdi-dock-left"></i>
        <div>Layout</div>
      </a>
      <ul class="menu-sub">
        <li class='menu-item@(currentPage == "/SampleOnly/Layout/Vertical" ? " active" : "")'>
            <a asp-controller="SampleOnly" asp-action="VerticalLayout" class="menu-link">
                <div>Vertical</div>
            </a>
        </li>
        <li class='menu-item@(currentPage == "/SampleOnly/Layout/Horizontal" ? " active" : "")'>
            <a asp-controller="SampleOnly" asp-action="HorizontalLayout" class="menu-link">
                <div>Horizontal</div>
            </a>
        </li>
      </ul>
    </li>
    <!-- Layout -->
    <!-- Module -->
    <li class='menu-item @(currentPage.StartsWith("/Error") || currentPage.StartsWith("/User") ? " active open" : "")'>
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon tf-icons mdi mdi-database-edit-outline"></i>
        <div>Module</div>
      </a>
      <ul class="menu-sub">
        <li class='menu-item@(currentPage.StartsWith("/Error") ? " active" : "")'>
            <a asp-controller="Error" asp-action="Index" class="menu-link">
                <div>Error</div>
            </a>
        </li>
        <li class='menu-item@(currentPage.StartsWith("/User") ? " active" : "")'>
            <a asp-controller="User" asp-action="Index" class="menu-link">
                <div>User</div>
            </a>
        </li>
      </ul>
    </li>
    <!-- Module -->
    <!-- Sample -->
    <li class='menu-item@(currentPage == "/SampleOnly/Demo" ? " active" : "")'>
        <a asp-controller="SampleOnly" asp-action="Demo" class="menu-link">
            <i class="menu-icon tf-icons mdi mdi-file-document-multiple-outline"></i>
            <div>Sample Integration</div>
        </a>
    </li>
    <!-- Sample -->
  </ul>
</aside>
<!-- / Menu -->

@{
    ViewData["Title"] = "Home Page";
}

<!-- Custom content with heading -->
<div class="row">
    <div class="col-lg-12">
        <h3 class="text-light">What's New</h3>
        <div class="demo-inline-spacing mt-3">
            <div class="list-group">
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">.NET 8 runtime</h5>
                    </div>
                    <p class="mb-1">Improvements to performance, garbage collection, and the core and extension libraries.</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">C# 12</h5>
                    </div>
                    <p class="mb-1">C# 12 shipped with the .NET 8 SDK.</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">EF Core</h5>
                    </div>
                    <p class="mb-1">Entity Framework Core includes improvements to complex type objects, collections of primitive types, JSON column mapping, raw SQL queries, lazy loading, tracked-entity access, model building, math translations, and other features.</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">ThemeSelection (Materio)</h5>
                    </div>
                    <p class="mb-1">Production-ready, easy to use, feature-rich, and highly customizable ASP.NET Core Admin Dashboard Template to build modern, eye-catching and responsive web apps in no time!</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">Bootstrap 5.3</h5>
                    </div>
                    <p class="mb-1">Bootstrap is a powerful, feature-packed frontend toolkit. Build anything—from prototype to production—in minutes.</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">Security Compliance</h5>
                    </div>
                    <p class="mb-1">Credential management, response header, dependency check, latest framework, latest libraries, etc...</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">SonarQube Quality Gate</h5>
                    </div>
                    <p class="mb-1">A-Security, A-Reliability, A-Maintainability, A-Hotspot Review, 1.6%-Code Duplication</p>
                </div>
                <div class="list-group-item flex-column align-items-start">
                    <div class="d-flex justify-content-between w-100">
                        <h5 class="mb-1">Same familiar structure (Microservices)</h5>
                    </div>
                    <p class="mb-1">Same familiar structure, with improvements on core services, methods, views, integration, result paging, jitter rettry, etc..</p>
                </div>
            </div>
        </div>
    </div>
</div>


<!--/ Custom content with heading -->
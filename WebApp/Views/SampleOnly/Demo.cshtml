@using Common.Constants
@using WebApp.Models.SelectList
@{
    ViewData["Title"] = "Sample";
}

<div class="row">
    <!-- DotNet8 API -->
    <div class="col-md col-md-4 mb-3">
        <div class="card">
            <h5 class="card-header">DotNet8 API</h5>
            <div class="card-body">
                <div>
                    <label for="ddl-user" class="form-label">User</label>
                    @{
                        @await Component.InvokeAsync("SelectList", new SelectListParam() { ControlId = "ddl-user", ApiEndpoint = ReferenceDataConstant.UsersApiRoute, EnableCache = false })
                    }
                    <div id="ddl-user" class="form-text"> Sample single select from API.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Mapping -->
